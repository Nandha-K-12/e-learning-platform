# Upstream servers
upstream uwsgi_app {
    server unix:/tmp/elearn.sock;
}

upstream daphne {
    server unix:/tmp/daphne.sock;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name *.educaproject.com educaproject.com;
    return 301 https://$host$request_uri;
}

# HTTPS Server (SSL/TLS, Static/Media, uWSGI & Daphne)
server {
    listen 443 ssl;
    ssl_certificate /etc/ssl/certs/educaproject.crt;
    ssl_certificate_key /etc/ssl/private/educaproject.key;
    server_name *.educaproject.com educaproject.com;

    # SSL protocols and ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/elearn_access.log;
    error_log /var/log/nginx/elearn_error.log;

    # Serve static assets directly
    location /static/ {
        alias /home/env/elearn/staticfiles/;
        expires 30d;
        access_log off;
    }

    # Serve media uploads directly
    location /media/ {
        alias /home/env/elearn/media/;
        expires 30d;
        access_log off;
    }

    # Route WebSockets to Daphne ASGI Server
    location /ws/ {
        proxy_pass http://daphne;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
    }

    # Route standard HTTP requests to uWSGI
    location / {
        include uwsgi_params;
        uwsgi_pass uwsgi_app;
        uwsgi_param Host $host;
        uwsgi_param X-Real-IP $remote_addr;
        uwsgi_param X-Forwarded-For $proxy_add_x_forwarded_for;
        uwsgi_param X-Forwarded-Proto https;
    }
}
